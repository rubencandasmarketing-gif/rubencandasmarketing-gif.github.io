# ============================================================
#  rubencandas.com — configuracion del servidor
# ============================================================
#  Si algo dejara de funcionar tras subir este archivo,
#  borralo desde el Administrador de archivos y la web
#  volvera al estado anterior. No rompe nada de forma
#  permanente.
# ============================================================

# --- Pagina de error propia (la del adolescente sin wifi) ---
ErrorDocument 404 /404.html

# --- Declarar UTF-8 tambien desde el servidor ---
# Sin esto el servidor no dice en que codificacion van las paginas y
# el navegador tiene que deducirlo del <meta charset> del HTML.
# Con esto, las tildes y las eñes no dependen de esa deduccion.
AddDefaultCharset UTF-8

# --- Forzar https:// y dominio sin www ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Nunca redirigir la carpeta de validacion del certificado SSL
  RewriteCond %{REQUEST_URI} !^/\.well-known/

  # Si entra sin cifrar, o entra por www, mandamos a la version buena
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://rubencandas.com%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Cabeceras de seguridad ---
<IfModule mod_headers.c>
  # Obliga al navegador a usar siempre conexion cifrada con este dominio.
  # OJO: el navegador MEMORIZA esta orden durante max-age segundos, aunque
  # se quite esta linea. Empezamos con 1 dia (86400). Cuando lleve unas
  # semanas sin incidencias, subir a 31536000 (un anio).
  Header always set Strict-Transport-Security "max-age=86400"

  # Impide que otra web meta la tuya dentro de un marco invisible
  # y confunda a tus visitantes superponiendo botones (clickjacking).
  Header always set X-Frame-Options "DENY"

  # Impide que el navegador "adivine" el tipo de un archivo y acabe
  # ejecutando como codigo algo que se hace pasar por imagen.
  Header always set X-Content-Type-Options "nosniff"

  # Al salir hacia otra web solo se envia el dominio, no la pagina exacta.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Declara que esta web no usa camara, microfono ni ubicacion.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Lista blanca de lo que la web puede cargar o contactar.
  # 'unsafe-inline' es necesario porque los estilos y scripts van dentro
  # del propio HTML. Aun asi, bloquea cargar codigo de terceros.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://tracker.metricool.com; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# --- Comprimir el texto para que la web cargue mas rapido ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Guardar en cache las imagenes y tipografias del visitante ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg  "access plus 1 year"
  ExpiresByType image/png   "access plus 1 year"
  ExpiresByType image/webp  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  # El HTML no se cachea: asi los cambios se ven al momento
  ExpiresByType text/html   "access plus 0 seconds"
</IfModule>

# --- No enseñar el listado de archivos de las carpetas ---
Options -Indexes
